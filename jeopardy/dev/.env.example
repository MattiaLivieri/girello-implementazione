# Modello delle credenziali per l'istanza CTFd di sviluppo.
# Generare quattro valori casuali distinti di 32 byte,
# rappresentati ciascuno da 64 caratteri esadecimali.
# Conservare i valori effettivi nel file .env, escluso da Git.
# Mantenere le stesse credenziali quando si riutilizzano i volumi.

JEO_DEV_SECRET_KEY=
JEO_DEV_DB_PASSWORD=
JEO_DEV_DB_ROOT_PASSWORD=
JEO_DEV_REDIS_PASSWORD=