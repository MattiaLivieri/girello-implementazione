# Base locale contenente Python e le dipendenze dei servizi.
FROM girello/ad-runtime:1

ENV HELPDESK_DATA_DIR=/data

WORKDIR /app

# Controlla i requisiti usando le librerie gia' installate.
COPY requirements.txt .
RUN pip install --no-index --no-cache-dir -r requirements.txt \
    && pip check

# Mantiene lo stesso utente e gli stessi permessi del servizio originale.
RUN groupadd --gid 10001 helpdesk \
    && useradd --uid 10001 --gid helpdesk --no-create-home helpdesk \
    && mkdir /data \
    && chown helpdesk:helpdesk /data

COPY app.py .
COPY static/ ./static/

USER 10001:10001

EXPOSE 8082

CMD ["gunicorn", \
     "--bind", "0.0.0.0:8082", \
     "--workers", "1", \
     "--threads", "2", \
     "--timeout", "30", \
     "--worker-tmp-dir", "/tmp", \
     "--access-logfile", "-", \
     "--error-logfile", "-", \
     "app:create_app()"]
