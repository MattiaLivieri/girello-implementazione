# Modello per /srv/girello/secrets/ctfd.env.
# Per una nuova installazione, generare quattro valori distinti con:
# openssl rand -hex 32
# I valori esadecimali evitano caratteri speciali negli URL di connessione.
# Conservare le credenziali esistenti quando si riutilizzano i dati del portale.

# Chiave usata da CTFd per firmare le sessioni.
CTFD_SECRET_KEY=

# Password dell'utente ctfd nel database MariaDB.
CTFD_DB_PASSWORD=

# Password amministrativa di MariaDB.
MARIADB_ROOT_PASSWORD=

# Password condivisa da CTFd e Redis.
CTFD_REDIS_PASSWORD=
